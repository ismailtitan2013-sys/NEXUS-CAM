<Window x:Class="NexusCam.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NEXUS CAM" Height="860" Width="1420" MinHeight="720" MinWidth="1120" WindowStartupLocation="CenterScreen" Background="#070B14" Foreground="#F4F7FF">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Foreground" Value="#F7F9FF"/><Setter Property="Background" Value="#263B60"/><Setter Property="BorderBrush" Value="#607FB5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,11"/><Setter Property="Margin" Value="0,5"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#A8C4FF"/><Setter TargetName="b" Property="Opacity" Value=".9"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value=".72"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ComboBox"><Setter Property="Margin" Value="0,7,0,11"/><Setter Property="Padding" Value="8"/><Setter Property="MinHeight" Value="36"/></Style><Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D9E4FA"/><Setter Property="Margin" Value="0,8"/><Setter Property="FontSize" Value="13"/></Style>
</Window.Resources>
<Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="NEXUS CAM" FontSize="31" FontWeight="Bold"/><TextBlock Text="YOUR CAMERA. YOUR LOOK." Foreground="#8FA8D5" FontSize="11" Margin="2,4,0,0"/></StackPanel><Border Grid.Column="1" Background="#182943" BorderBrush="#45618F" BorderThickness="1" CornerRadius="18" Padding="16,9" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#75E0B1" Margin="0,0,9,0"/><TextBlock Text="LOCAL WORKSPACE  •  PREVIEW" Foreground="#C8D8FF" FontSize="11" FontWeight="SemiBold"/></StackPanel></Border></Grid>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
<Border Background="#101A2B" BorderBrush="#354D70" BorderThickness="1" CornerRadius="24" Padding="14" Margin="0,0,20,0"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#050911" CornerRadius="17" ClipToBounds="True"><Grid><Image x:Name="CameraImage" Stretch="Uniform"/><Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16" Background="#B30B1424" BorderBrush="#526B95" BorderThickness="1" CornerRadius="10" Padding="10,6"><StackPanel Orientation="Horizontal"><Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="#77849B" Margin="0,0,8,0"/><TextBlock x:Name="PreviewBadge" Text="CAMERA OFFLINE" Foreground="#E5ECFF" FontSize="10" FontWeight="SemiBold"/></StackPanel></Border></Grid></Border><Grid Grid.Row="1" Margin="5,13,5,2"><TextBlock x:Name="CameraStatus" Text="Готово к запуску камеры" Foreground="#C0CDE6" VerticalAlignment="Center"/><TextBlock Text="LIVE PREVIEW" Foreground="#7188B2" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Grid></Border>
<Border Grid.Column="1" Background="#111D30" BorderBrush="#354D70" BorderThickness="1" CornerRadius="24" Padding="20"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Панель управления" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/><TextBlock Text="КАМЕРА" Foreground="#829BC5" FontSize="10" FontWeight="Bold"/><TextBlock Text="Источник" Foreground="#B6C6E2"/><ComboBox x:Name="CameraSelector"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,7,0"><TextBlock Text="Разрешение" Foreground="#B6C6E2"/><ComboBox x:Name="ResolutionSelector" SelectedIndex="0"><ComboBoxItem Content="640 × 360"/><ComboBoxItem Content="1280 × 720"/><ComboBoxItem Content="1920 × 1080"/></ComboBox></StackPanel><StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="Частота кадров" Foreground="#B6C6E2"/><ComboBox x:Name="FpsSelector" SelectedIndex="1"><ComboBoxItem Content="15 FPS"/><ComboBoxItem Content="24 FPS"/><ComboBoxItem Content="30 FPS"/></ComboBox></StackPanel></Grid>
<Button x:Name="StartButton" Content="▶   Запустить камеру" Click="StartButton_Click" Background="#526FE0" BorderBrush="#91A8FF"/><Button x:Name="StopButton" Content="Остановить камеру" Click="StopButton_Click" IsEnabled="False"/><CheckBox x:Name="MirrorToggle" Content="Зеркальное отражение" IsChecked="True" Checked="MirrorToggle_Changed" Unchecked="MirrorToggle_Changed"/>
<Separator Background="#354D70" Margin="0,14"/><TextBlock Text="ФОН И ВИЗУАЛ" Foreground="#829BC5" FontSize="10" FontWeight="Bold" Margin="0,0,0,9"/>
<Border Background="#0B1423" BorderBrush="#304665" BorderThickness="1" CornerRadius="13" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#1A2A43" CornerRadius="9" Height="62" Width="66"><Image x:Name="BackgroundThumbnail" Stretch="UniformToFill"/></Border><StackPanel Grid.Column="1" Margin="11,2,0,0" VerticalAlignment="Center"><TextBlock x:Name="BackgroundName" Text="Фон не выбран" Foreground="#E5ECFF" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="Выбранное изображение" Foreground="#91A5C8" FontSize="10" Margin="0,4,0,0"/></StackPanel></Grid></Border>
<Button x:Name="ChooseBackgroundButton" Content="＋   Выбрать изображение" Click="ChooseBackgroundButton_Click"/><TextBlock Text="Выбор и предпросмотр картинки работают. AI-отделение человека от фона — следующий этап." Foreground="#9FB1D0" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,8"/>
<Separator Background="#354D70" Margin="0,12"/><TextBlock Text="ЭФФЕКТЫ И ZOOM" Foreground="#829BC5" FontSize="10" FontWeight="Bold"/><Button x:Name="AiButton" Content="✨  Загрузить AI-модуль и включить фон" Click="AiButton_Click" Background="#354B82" BorderBrush="#8BA6F0" Margin="0,9,0,5"/><TextBlock x:Name="AiStatus" Text="AI-модуль загружается только по нажатию. Первый запуск скачает модель примерно 26 МБ." Foreground="#9FB1D0" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,5"/><TextBlock Text="Виртуальная камера для Zoom — следующий отдельный этап." Foreground="#9FB1D0" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,5"/>
</StackPanel></ScrollViewer></Border></Grid>
<Grid Grid.Row="2" Margin="3,15,3,0"><TextBlock Text="NEXUS CAM  •  WINDOWS 11  •  LOCAL PROCESSING" Foreground="#7186AA" FontSize="10"/><TextBlock Text="BUILD 0.2" Foreground="#7186AA" FontSize="10" HorizontalAlignment="Right"/></Grid></Grid></Window>